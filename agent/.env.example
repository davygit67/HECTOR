# Copy to agent/.env and enter your own API key locally. Never put it in a VITE_ variable.
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.4-mini
AGENT_MAX_STEPS=12
AGENT_MAX_OUTPUT_TOKENS=1500
AGENT_PROGRAM_MAX_OUTPUT_TOKENS=6000
AGENT_PROGRAM_REASONING_EFFORT=medium
AGENT_TIMEOUT_MS=90000
AGENT_HISTORY_TURNS=10
