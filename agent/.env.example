# Copy to agent/.env and enter your own API key locally. Never put it in a VITE_ variable.
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.4-mini
AGENT_MAX_STEPS=12
AGENT_MAX_OUTPUT_TOKENS=1500
AGENT_PROGRAM_MAX_OUTPUT_TOKENS=6000
AGENT_PROGRAM_REASONING_EFFORT=medium
AGENT_TIMEOUT_MS=90000
AGENT_HISTORY_TURNS=10

# Optional cloud receiver; leave all three unset until connecting a relay.
# These credentials are separate from OPENAI_API_KEY. Never use VITE_ variables.
# ChatGPT / Codex private tunnel setup: CHATGPT_CONNECTION.md
# PROJECTION_RELAY_URL=https://your-relay-host
# PROJECTION_RELAY_DEVICE_ID=home-studio
# PROJECTION_RELAY_DEVICE_TOKEN=replace-with-private-device-credential

# Relay process only (see CLOUD_PROJECTION.md); use a different submit credential.
# PROJECTION_RELAY_SUBMIT_TOKEN=replace-with-private-submit-credential
# PROJECTION_RELAY_STORE=/absolute/private/path/projection-inbox.json
# PROJECTION_RELAY_BIND=127.0.0.1
# PROJECTION_RELAY_PORT=8787
# PROJECTION_RELAY_ALLOWED_HOSTS=127.0.0.1:8787,localhost:8787
