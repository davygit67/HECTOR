{
  "name": "projection-mapper-prototype",
  "productName": "Projection Mapper",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "start": "npm run build && electron .",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "collaboration:setup": "node host/install-git-hooks.mjs",
    "repo:check": "node host/repository-safety.mjs --history",
    "repo:sync": "node host/git-sync.mjs"
  },
  "dependencies": {
    "quickjs-emscripten": "0.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
