{
  "name": "hector",
  "version": "0.1.0",
  "private": true,
  "description": "Independent desktop projection mapping studio",
  "author": "HECTOR contributors",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "electron:install": "install-electron",
    "presmoke": "install-electron",
    "smoke": "npm run build && playwright test --project=qualification",
    "premeasure": "install-electron",
    "measure": "npm run build && playwright test --project=pacing",
    "package": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "app.hector.studio",
    "productName": "HECTOR",
    "artifactName": "${productName}-${version}-${os}-${arch}-unsigned.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-win-${arch}-unsigned-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "hardenedRuntime": false
    }
  }
}
